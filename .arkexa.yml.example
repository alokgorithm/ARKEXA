# ARKEXA configuration. Copy to .arkexa.yml in the root of your repository.
#
# There is exactly one setting: what to ignore. Everything else about what gets
# reported is decided by reachability, which is a property of your workflow
# rather than of your configuration.

ignore:
  # Every entry needs a reason. An ignore without one is reported and NOT
  # applied, because an ignore nobody can explain is how a scanner quietly
  # stops working.
  - rule: ARK004
    path: .github/workflows/nightly.yml
    reason: runs in an isolated container with no token mounted

  # `path` is a glob, and defaults to * when omitted.
  - rule: ARK003
    path: .github/workflows/experimental/*.yml
    reason: sandbox workflows, tracked in issue 41

  # `rule` is a glob too, so this silences everything in one file. Prefer not
  # to: a narrow ignore keeps working when a new rule is added, a broad one
  # silently swallows it.
  - rule: "*"
    path: .github/workflows/vendor-generated.yml
    reason: generated by the vendor SDK, we do not edit it

# Before adding an ignore, check whether a guard would be better. An `if:` on
# author_association, an actor allowlist or a label gate demotes the finding
# out of the default report on its own, and unlike an ignore it also stops the
# attack.
#
# If ARKEXA is wrong rather than inconvenient, that is a bug worth reporting:
# https://github.com/alokgorithm/ARKEXA/issues/new/choose
